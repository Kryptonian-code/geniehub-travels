VITE_APP_NAME=GenieHub
VITE_APP_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost/ghanaian-dream-travel-main/api

# Client auth automatically uses Firebase only when all four values below are set.
# If any of them are blank, GenieHub falls back to the local auth system.
VITE_AUTH_PROVIDER=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Fastest launch stack
VITE_PAYMENT_PROVIDER=paystack
VITE_PAYSTACK_PUBLIC_KEY=

VITE_WHATSAPP_PROVIDER=twilio
VITE_TWILIO_WHATSAPP_NUMBER=

VITE_MAIL_PROVIDER=sendgrid
VITE_MAIL_FROM_EMAIL=

VITE_GA_MEASUREMENT_ID=
VITE_ENABLE_MONITORING=true

VITE_MAX_UPLOAD_MB=10
VITE_ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Server-side/provider secrets for local launch wiring
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
